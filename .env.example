# VerveStride Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# Razorpay Keys
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_HERE

# Replicate API Key (for AI image/video/audio generation)
# Get this from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_YOUR_TOKEN_HERE

# Company Logo URL
# Upload your logo to Firebase Storage or CDN and paste URL here
COMPANY_LOGO_URL=https://your-domain.com/logo.png

# Build Instructions:
# 
# Linux/Mac:
#   export RAZORPAY_KEY_ID=rzp_live_xxx
#   export RAZORPAY_KEY_SECRET=your_secret
#   ./build_production.sh android
#
# Windows:
#   set RAZORPAY_KEY_ID=rzp_live_xxx
#   set RAZORPAY_KEY_SECRET=your_secret
#   build_production.bat android
